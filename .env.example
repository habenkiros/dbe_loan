# Copy to `.env` and fill in values. Never commit `.env`.
#
# Generate SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# --- Required for any non-debug deploy ---
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000

# --- Database (Compose service hostname is `db`) ---
DB_NAME=decsiloandb
DB_USER=decsiloandbuser
DB_PASSWORD=replace-with-strong-db-password
DB_HOST=db
DB_PORT=5432

# --- Sessions ---
SESSION_COOKIE_AGE=28800
SESSION_EXPIRE_AT_BROWSER_CLOSE=True
PASSWORD_MIN_LENGTH=10

# --- Auth hardening (INSA / bank deploy) ---
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
MFA_REQUIRED=True
MFA_TOTP_ISSUER=DECSI Loan Hub
SESSION_IDLE_TIMEOUT=1800
SESSION_IDLE_WARNING_SECONDS=120

# --- HTTPS (set when using docker-compose.https.yml) ---
# USE_HTTPS_PROXY=1
# HTTPS_SECURE_COOKIES=1
# SECURE_SSL_REDIRECT=True
# CSRF_TRUSTED_ORIGINS=https://localhost:8443,https://your.bank.et

# --- CBS / party (keep mock until you have live access) ---
DECSI_CUSTOMER_FALLBACK_MOCK=True
DECSI_CBS_USE_MOCK_LEDGER=True
# DECSI_BASE_URL=
# DECSI_CBS_API_KEY=

# --- Optional ---
# LOG_LEVEL=INFO
# GEBETA_MAPS_API_KEY=
# OPENAI_API_KEY=
# AGENT_LLM_PROVIDER=stub
