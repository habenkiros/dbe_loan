# =============================================================================
# DECSI Loan Hub — environment template
# Copy to `.env` and fill in values. Never commit `.env`.
#
#   cp .env.example .env
#
# Generate SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# Local Docker: leave API keys empty / FORCE_MOCK=True until go-live.
# =============================================================================

# --- Core Django ---
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
# Comma-separated hosts (Compose / LAN). Settings may still allow * in some builds.
ALLOWED_HOSTS=localhost,127.0.0.1,web
SITE_URL=http://localhost:8000

# --- Database (Compose service hostname is `db`) ---
DB_NAME=decsiloandb
DB_USER=decsiloandbuser
DB_PASSWORD=replace-with-strong-db-password
DB_HOST=db
DB_PORT=5432

# --- Sessions / auth hardening ---
SESSION_COOKIE_AGE=28800
SESSION_EXPIRE_AT_BROWSER_CLOSE=True
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
MFA_REQUIRED=False
MFA_TOTP_ISSUER=DECSI Loan Hub
SESSION_IDLE_TIMEOUT=1800
SESSION_IDLE_WARNING_SECONDS=120

# --- Email (committee / portal notices; console backend for local) ---
DEFAULT_FROM_EMAIL=noreply@decsi.local
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- HTTPS field tablets (docker-compose.https.yml) ---
# ./scripts/gen_field_https_certs.sh writes deploy/https/.env.https (no pinned LAN IP).
# USE_HTTPS_PROXY=1
# HTTPS_SECURE_COOKIES=0
# HTTPS_ALLOW_ANY_HOST=1
# Do not set SITE_URL / CSRF_TRUSTED_ORIGINS to a single DHCP address.

# --- Gunicorn (production container; optional locally) ---
# Production Docker: USE_GUNICORN=1 (migrate + collectstatic + gunicorn instead of runserver)
# USE_GUNICORN=0
# GUNICORN_BIND=0.0.0.0:8000
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=120
# GUNICORN_GRACEFUL_TIMEOUT=30
# GUNICORN_KEEPALIVE=5
# GUNICORN_LOG_LEVEL=info
# FORWARDED_ALLOW_IPS=*
# WEB_PORT=8000

# --- Nightly backup (Compose service `backup`, 00:00 Africa/Addis_Ababa) ---
# Archives land in ./backups/decsi_backup_YYYYMMDD_HHMMSS.tar.gz
BACKUP_RETENTION_DAYS=14
BACKUP_TZ=Africa/Addis_Ababa

# =============================================================================
# EXTERNAL APIs
# =============================================================================

# --- DECSI / Temenos CBS — customer party lookup (Sheet 1, Digital Apply) ---
# Leave DECSI_BASE_URL empty to use offline mock catalog.
DECSI_BASE_URL=
DECSI_CBS_API_KEY=
DECSI_CUSTOMER_TIMEOUT=8
DECSI_CUSTOMER_FORCE_MOCK=False
DECSI_CUSTOMER_FALLBACK_MOCK=True
DECSI_CUSTOMER_DETAIL_PATH=/getCusByCusNo/api/v1.0.0/party/custid/{cid}/custdets
DECSI_TRANSACTIONS_PATH=/getCusByCusNo/api/v1.0.0/party/custid/{cid}/transactions

# --- DECSI / Temenos CBS — outstanding + disbursement booking ---
# mock ledger = offline demo; set USE_MOCK_LEDGER=False + BASE_URL for live booking.
DECSI_LEDGER_ADAPTER=auto
DECSI_CBS_ENABLED=True
DECSI_CBS_USE_MOCK_LEDGER=True
DECSI_CBS_FORCE_MOCK=False
DECSI_CBS_TIMEOUT=8
DECSI_OUTSTANDING_PATH=/getCusByCusNo/api/v1.0.0/party/custid/{cid}/outstanding
DECSI_DISBURSE_PATH=/loanDisburse/api/v1.0.0/loans/disburse
DECSI_CBS_BOOK_ON_DISBURSE=True

# Sanctions / PEP screening (Fraud/AML desk) — mock demo list by default
# Demo hits: customer SANCTIONED001 / PEP0000001, or name "Sanctioned Demo Person"
# SANCTIONS_PROVIDER=mock
# SANCTIONS_PROVIDER=http
# SANCTIONS_HTTP_URL=https://screening.example/api
# SANCTIONS_HTTP_PATH=/screen
# SANCTIONS_HTTP_API_KEY=
# SANCTIONS_DEMO_EXTRA_NAMES=
# SANCTIONS_PROVIDER=off

# --- Chapa (Digital Apply processing fee) ---
# Dashboard: https://dashboard.chapa.co — empty keys or FORCE_MOCK=True = mock checkout.
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_CURRENCY=ETB
CHAPA_FORCE_MOCK=True

# --- Applicant SMS gateway (OTP / loan status) ---
# POST JSON body: { "to": "<msisdn>", "message": "<text>" }
# Authorization: API key as configured by your SMS provider.
APPLICANT_SMS_URL=
APPLICANT_SMS_API_KEY=

# --- Gebeta Maps (field GPS geocode + Ethiopia map tiles) ---
# Docs: https://docs.gebeta.app/docs
GEBETA_MAPS_API_KEY=
GEBETA_MAPS_GEOCODE_URL=https://mapapi.gebeta.app/api/v1/route/geocoding
GEBETA_MAPS_TIMEOUT=8
# auto | gebeta | nominatim
GEBETA_MAPS_GEOCODE_PROVIDER=auto
# auto | gebeta | leaflet_osm
GEBETA_MAPS_TILES_PROVIDER=auto
GEBETA_MAPS_STYLE_STANDARD=https://tiles.gebeta.app/styles/standard/style.json
GEBETA_MAPS_STYLE_SATELLITE=https://tiles.gebeta.app/styles/raster/raster.json
GEBETA_MAPS_STYLE_TERRAIN=https://tiles.gebeta.app/styles/standard/terrain/terrain.json

# --- Agentic Assist (staff chatbot) ---
# auto = OpenAI when OPENAI_API_KEY set, else stub; force with openai|stub
AGENT_LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Azure OpenAI only:
# OPENAI_BASE_URL=https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
# OPENAI_API_VERSION=2024-08-01-preview
AGENT_LLM_TIMEOUT=60

# --- Document intelligence (OCR + optional LLM assist / ID verify) ---
DOCUMENT_OCR_LANG=eng+amh
# DOCUMENT_OCR_MATCH_MIN_SCORE=60
# DOCUMENT_LLM_PROVIDER=openai
# OPENAI_DOCUMENT_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_DOCUMENT_MODEL=gemini-1.5-flash
# EXTERNAL_ID_VERIFY_URL=

# =============================================================================
# GO-LIVE CHECKLIST (set mocks off when keys/URLs are real)
# =============================================================================
# [ ] SECRET_KEY unique, DEBUG=False, MFA_REQUIRED=True
# [ ] USE_GUNICORN=1 for production Docker (migrate + collectstatic + gunicorn)
# [ ] DECSI_BASE_URL + DECSI_CBS_API_KEY; DECSI_CBS_USE_MOCK_LEDGER=False
#     (see docs/deployment/CBS_CUTOVER_CHECKLIST.md)
# [ ] CHAPA_SECRET_KEY + CHAPA_PUBLIC_KEY; CHAPA_FORCE_MOCK=False; SITE_URL public HTTPS
# [ ] DECSI_AUTO_QUEUE_ON_PAID=True (paid + docs complete → branch queue automatically)
# [ ] APPLICANT_SMS_URL + APPLICANT_SMS_API_KEY
# [ ] GEBETA_MAPS_API_KEY (field maps)
# [ ] OPENAI_API_KEY if Agentic Assist should use a real LLM
# [ ] SMTP EMAIL_* for staff email notices
#     EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#     EMAIL_HOST=… EMAIL_HOST_USER=… EMAIL_HOST_PASSWORD=… DEFAULT_FROM_EMAIL=…
# [ ] USE_HTTPS_PROXY=1 + CSRF_TRUSTED_ORIGINS for tablet field visits

# =============================================================================
# ON-PREM PRODUCT LICENSE (Seqela-signed; required when DEBUG=False)
# =============================================================================
# Paste the full SEQLA1.… key issued by Seqela for Dedebit / DECSI.
# LICENSE_KEY=
# Or point to a file (one line):
# LICENSE_KEY_FILE=/opt/decsi_loan/deploy/license/license.key
# Grace days after expiry before hard lockout (default 7):
# LICENSE_GRACE_DAYS=7
# Force on/off (unset = enforce automatically when DEBUG=False):
# LICENSE_ENFORCE=True
