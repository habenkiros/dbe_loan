# =============================================================================
# DBE Credit Intelligence — environment template (for IT)
# Institution: Development Bank of Ethiopia (DBE)
# Product:     Credit Intelligence
#
# HOW TO USE (on the Ubuntu server)
# ---------------------------------
#   cd /opt/dbe_loan          # or wherever you cloned the project
#   cp .env.example .env
#   nano .env                 # fill ONLY the REQUIRED section below
#   docker compose up --build -d
#
# Never commit the real `.env` file (it has secrets).
# Leave sections marked "DO NOT CHANGE" / "LEAVE FOR PILOT" alone unless Seqela
# or DBE IT says otherwise.
# =============================================================================


# =============================================================================
# >>> REQUIRED — IT MUST SET THESE BEFORE FIRST START <<<
# =============================================================================

# 1) Django secret (already filled for this pilot pack — do not share outside DBE)
SECRET_KEY=fCqNhb2R6nCiBSr5uN0uBYlFLu9klzXfZNqIEXGNOrggkOe5Oc6PyVftsU6RjVRvE8s

# 2) Production mode on the server (keep False)
DEBUG=False

# 3) Server address — INSTALL_ON_SERVER.sh fills this automatically.
#    If you edit by hand: replace REPLACE_WITH_SERVER_IP with output of: hostname -I
#    Example: ALLOWED_HOSTS=localhost,127.0.0.1,10.47.137.168
ALLOWED_HOSTS=localhost,127.0.0.1,REPLACE_WITH_SERVER_IP
SITE_URL=http://REPLACE_WITH_SERVER_IP:8000
WEB_PORT=8000

# 4) Database password (Compose creates Postgres with this)
#    Pilot default below is fine. Change only for hardened production, then
#    keep the same value in .env after first start (changing it later breaks DB).
#    Do not change DB_NAME / DB_USER / DB_HOST below.
DB_PASSWORD=decsiloandbpassword

# 5) Product license (Seqela-signed; 1-month pilot for DBE)
#    Valid: 2026-09-25 → 2026-10-25 inclusive.
#    LICENSE_GRACE_DAYS=0 → product locks starting 2026-10-26 (no extra grace days).
#    Same key is in deploy/license/license.key — renew with Seqela after expiry.
LICENSE_KEY=SEQLA1..31kjdymPvPoaNC5RKPVF2H0ewpW8ZHIVlqrqlJnvns4X7q58g9AiUsCegHOEq_Wsotea07fQBjIry4I4HfqYCQ
LICENSE_ENFORCE=True
LICENSE_GRACE_DAYS=0


# =============================================================================
# BRANDING (defaults are correct for DBE — usually leave as-is)
# =============================================================================
INSTITUTION_NAME=Development Bank of Ethiopia
INSTITUTION_SHORT=DBE
PRODUCT_NAME=Credit Intelligence
MFA_TOTP_ISSUER=DBE Credit Intelligence
DEFAULT_FROM_EMAIL=noreply@dbe.local


# =============================================================================
# DATABASE — DO NOT CHANGE (Docker Compose service name is "db")
# =============================================================================
DB_NAME=decsiloandb
DB_USER=decsiloandbuser
DB_PASSWORD=decsiloandbpasswordDB_HOST=db
DB_PORT=5432


# =============================================================================
# SECURITY (sensible pilot defaults)
# =============================================================================
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10
# Turn MFA_REQUIRED=True after staff are trained and can enroll authenticator apps
MFA_REQUIRED=False
SESSION_IDLE_TIMEOUT=1800
SESSION_IDLE_WARNING_SECONDS=120
SESSION_COOKIE_AGE=28800
SESSION_EXPIRE_AT_BROWSER_CLOSE=True


# =============================================================================
# PILOT / OFFLINE DEFAULTS — LEAVE AS-IS UNTIL CBS / PAYMENTS GO LIVE
# (Mocks = app works without connecting to core banking or Chapa)
# =============================================================================
DECSI_CUSTOMER_FALLBACK_MOCK=True
DECSI_CBS_USE_MOCK_LEDGER=True
CHAPA_FORCE_MOCK=True
CHAPA_CURRENCY=ETB
DOCUMENT_OCR_LANG=eng+amh


# =============================================================================
# EMAIL (optional for pilot — password reset / notices need SMTP later)
# =============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For real mail later, switch to SMTP and fill:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True


# =============================================================================
# BACKUPS (Compose "backup" service — nightly 00:00 Africa/Addis_Ababa)
# Files appear under ./backups/ on the server
# =============================================================================
BACKUP_RETENTION_DAYS=14
BACKUP_TZ=Africa/Addis_Ababa


# =============================================================================
# OPTIONAL — leave empty for pilot (configure only when integrations are ready)
# =============================================================================

# --- Core banking / CBS (customer lookup + disbursement) ---
# BANK_CBS_BASE_URL=
# BANK_CBS_API_KEY=
# DECSI_BASE_URL=
# DECSI_CBS_API_KEY=
# When live: DECSI_CBS_USE_MOCK_LEDGER=False and set BASE_URL + API key

# --- Chapa (Digital Apply fees) ---
# CHAPA_SECRET_KEY=
# CHAPA_PUBLIC_KEY=
# When live: CHAPA_FORCE_MOCK=False

# --- SMS (applicant OTP / status) ---
# APPLICANT_SMS_URL=
# APPLICANT_SMS_API_KEY=

# --- Maps (field GPS) ---
# GEBETA_MAPS_API_KEY=

# --- Agentic Assist / document LLM ---
# OPENAI_API_KEY=
# AGENT_LLM_PROVIDER=auto


# =============================================================================
# AFTER FIRST START — VERIFY
# =============================================================================
#   docker compose ps
#   docker compose exec web python manage.py migrate
#   docker compose exec web python manage.py createsuperuser
#   docker compose exec web python manage.py check_license
#
# Open (replace SERVER_IP):
#   Staff hub:      http://SERVER_IP:8000/hub/login/
#   Digital Apply:  http://SERVER_IP:8000/
#   License:        http://SERVER_IP:8000/license/
#
# If browser shows DisallowedHost: put the same IP in ALLOWED_HOSTS and SITE_URL,
# then:  docker compose restart web
# =============================================================================
